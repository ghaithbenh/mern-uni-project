PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=remplace-moi-par-un-secret-long-et-aleatoire
CLIENT_URL=http://localhost:5173
# Nombre de proxys de confiance (0 en local, 1 sur Render/Railway)
TRUST_PROXY=0
# Emails administrateurs, séparés par des virgules
ADMIN_EMAILS=admin@example.com
